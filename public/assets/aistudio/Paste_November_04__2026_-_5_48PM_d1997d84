- name
- slug UNIQUE
- logo_url
- cover_url
- description
- website
- industry
- company_size
- headquarters
- country
- city
- social_links JSONB
- created_at
- updated_at

jobs:

- id UUID PRIMARY KEY
- title
- slug UNIQUE
- company_id REFERENCES companies(id)
- category_id REFERENCES categories(id)
- description
- responsibilities
- requirements
- qualifications
- benefits
- location
- city
- country
- workplace_type
- employment_type
- experience_level
- salary_min
- salary_max
- salary_currency
- salary_period
- salary_visible
- application_mode
- external_application_url
- application_deadline
- status
- is_featured
- published_at
- created_by
- created_at
- updated_at

categories:

- id UUID PRIMARY KEY
- name
- slug UNIQUE
- description
- icon
- created_at

skills:

- id UUID PRIMARY KEY
- name
- slug UNIQUE
- created_at

job_skills:

- job_id REFERENCES jobs(id)
- skill_id REFERENCES skills(id)
- PRIMARY KEY (job_id, skill_id)

applications:

- id UUID PRIMARY KEY
- job_id REFERENCES jobs(id)
