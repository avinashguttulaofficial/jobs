- resume_id
- cover_letter
- status
- applied_at
- updated_at

application_status_history:

- id UUID PRIMARY KEY
- application_id REFERENCES applications(id)
- previous_status
- new_status
- changed_by
- admin_note
- created_at

saved_jobs:

- id UUID PRIMARY KEY
- user_id REFERENCES profiles(id)
- job_id REFERENCES jobs(id)
